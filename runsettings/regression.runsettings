<?xml version="1.0" encoding="utf-8"?>
<!-- Регрессия: все тесты, 4 потока -->
<RunSettings>
  <RunConfiguration>
    <ResultsDirectory>./TestResults</ResultsDirectory>
    <EnvironmentVariables>
      <JEFIT_TestSettings__IsHeadless>true</JEFIT_TestSettings__IsHeadless>
    </EnvironmentVariables>
  </RunConfiguration>
  <NUnit>
    <NumberOfTestWorkers>4</NumberOfTestWorkers>
  </NUnit>
</RunSettings>
