<?xml version="1.0" encoding="utf-8"?>
<!-- Кросс-браузерный план: Mozilla Firefox -->
<RunSettings>
  <RunConfiguration>
    <ResultsDirectory>./TestResults</ResultsDirectory>
    <EnvironmentVariables>
      <JEFIT_TestSettings__BrowserType>Firefox</JEFIT_TestSettings__BrowserType>
      <JEFIT_TestSettings__IsHeadless>true</JEFIT_TestSettings__IsHeadless>
    </EnvironmentVariables>
  </RunConfiguration>
  <NUnit>
    <NumberOfTestWorkers>4</NumberOfTestWorkers>
  </NUnit>
</RunSettings>
